{
  "openapi": "3.1.0",
  "info": {
    "title": "Insurance BillingCenter API",
    "description": "Review policy billing accounts, invoices, and payments.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "billing_center_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Billing Center Health"
                }
              }
            }
          }
        }
      }
    },
    "/billing-accounts": {
      "get": {
        "summary": "Search Billing Accounts",
        "operationId": "search_billing_accounts",
        "parameters": [
          {
            "name": "customer_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Customer Id"
            }
          },
          {
            "name": "policy_number",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Policy Number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BillingAccount"
                  },
                  "title": "Response Search Billing Accounts"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/billing-accounts/{account_id}": {
      "get": {
        "summary": "Get Billing Account",
        "operationId": "get_billing_account",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Account Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingAccount"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/invoices": {
      "get": {
        "summary": "Search Invoices",
        "operationId": "search_invoices",
        "parameters": [
          {
            "name": "policy_number",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Policy Number"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "due",
                    "paid",
                    "overdue"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Invoice"
                  },
                  "title": "Response Search Invoices"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/billing-accounts/{account_id}/payments": {
      "post": {
        "summary": "Record Payment",
        "operationId": "record_payment",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Account Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordPaymentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentReceipt"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BillingAccount": {
        "properties": {
          "account_id": {
            "type": "string",
            "title": "Account Id"
          },
          "customer_id": {
            "type": "string",
            "title": "Customer Id"
          },
          "policy_number": {
            "type": "string",
            "title": "Policy Number"
          },
          "balance": {
            "type": "number",
            "title": "Balance"
          },
          "next_payment_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Payment Date"
          },
          "payment_plan": {
            "type": "string",
            "enum": [
              "monthly",
              "quarterly",
              "annual"
            ],
            "title": "Payment Plan"
          }
        },
        "type": "object",
        "required": [
          "account_id",
          "customer_id",
          "policy_number",
          "balance",
          "next_payment_date",
          "payment_plan"
        ],
        "title": "BillingAccount"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Invoice": {
        "properties": {
          "invoice_id": {
            "type": "string",
            "title": "Invoice Id"
          },
          "policy_number": {
            "type": "string",
            "title": "Policy Number"
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "title": "Due Date"
          },
          "amount": {
            "type": "number",
            "title": "Amount"
          },
          "status": {
            "type": "string",
            "enum": [
              "due",
              "paid",
              "overdue"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "invoice_id",
          "policy_number",
          "due_date",
          "amount",
          "status"
        ],
        "title": "Invoice"
      },
      "PaymentReceipt": {
        "properties": {
          "receipt_id": {
            "type": "string",
            "title": "Receipt Id"
          },
          "account_id": {
            "type": "string",
            "title": "Account Id"
          },
          "amount": {
            "type": "number",
            "title": "Amount"
          },
          "remaining_balance": {
            "type": "number",
            "title": "Remaining Balance"
          },
          "payment_method": {
            "type": "string",
            "title": "Payment Method"
          },
          "reference": {
            "type": "string",
            "title": "Reference"
          }
        },
        "type": "object",
        "required": [
          "receipt_id",
          "account_id",
          "amount",
          "remaining_balance",
          "payment_method",
          "reference"
        ],
        "title": "PaymentReceipt"
      },
      "RecordPaymentRequest": {
        "properties": {
          "amount": {
            "type": "number",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount"
          },
          "payment_method": {
            "type": "string",
            "enum": [
              "bank_account",
              "credit_card",
              "debit_card"
            ],
            "title": "Payment Method"
          },
          "reference": {
            "type": "string",
            "maxLength": 100,
            "minLength": 3,
            "title": "Reference"
          }
        },
        "type": "object",
        "required": [
          "amount",
          "payment_method",
          "reference"
        ],
        "title": "RecordPaymentRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
